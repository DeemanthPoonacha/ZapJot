rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the authenticated user matches the owner of the user document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Match all documents under the users collection hierarchy
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Match push subscriptions
    match /pushSubscriptions/{subscriptionId} {
      allow create: if isAuthenticated();
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
